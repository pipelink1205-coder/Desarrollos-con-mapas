# =====================================================================
# VARIABLES DE ENTORNO - PLANTILLA
# =====================================================================
# Copia este archivo como .env.local y completa los valores reales.
# El archivo .env.local NUNCA debe subirse a git (ya está en .gitignore).
# =====================================================================

# --------- SUPABASE ---------
# Encuéntralas en: Supabase Dashboard > Project Settings > API

# URL pública del proyecto (segura para exponer en el navegador)
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# Llave pública anon (segura para exponer en el navegador)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Llave de servicio (SECRETA - solo backend / scripts / serverless)
# NUNCA exponer al navegador. Solo se usa en api/ y scripts/
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --------- ADMIN INICIAL ---------
# Credenciales para crear el primer usuario admin con scripts/crear-admin.mjs
ADMIN_EMAIL=tu_correo@epi.gov.co
ADMIN_PASSWORD=cambia_esto_por_una_contrasena_fuerte
ADMIN_NOMBRE=Diana Administradora
